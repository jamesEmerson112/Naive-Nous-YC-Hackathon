# Copy to arm.env (setup.sh does this). arm.env is per-machine and git-ignored.
# Find ports with bin/find-ports.sh (unplug the arm when it asks).

# Follower = the arm that moves. Leader = the arm you move by hand.
FOLLOWER_PORT=/dev/tty.usbmodemXXXXXXXXXXX
LEADER_PORT=/dev/tty.usbmodemYYYYYYYYYYY

# Calibration is stored per id under ~/.cache/huggingface/lerobot/calibration.
# Use the same ids everywhere (calibrate, teleop, record, primitives).
FOLLOWER_ID=naive_follower
LEADER_ID=naive_leader

# Optional cameras for lerobot-record, LeRobot dict syntax. Leave empty for joints only.
# Find indexes with: .venv/bin/lerobot-find-cameras opencv
# CAMERAS="{front: {type: opencv, index_or_path: 0, width: 640, height: 480, fps: 30}}"
CAMERAS=

# Optional safety cap: max degrees a joint may move per control step (empty = no cap).
MAX_RELATIVE_TARGET=

# Dataset name for lerobot-record. Stays local (arm/data/) unless PUSH_TO_HUB=true.
DATASET_REPO_ID=naive-nous/so101_demo
PUSH_TO_HUB=false
