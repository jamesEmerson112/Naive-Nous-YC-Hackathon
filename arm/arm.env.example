# Copy to arm.env (setup.sh does this). arm.env is per-machine and git-ignored.

# Serial port of the arm (plug in USB + 12 V power, then: ls /dev/tty.usbmodem*).
ARM_PORT=/dev/tty.usbmodemXXXXXXXXXXX

# Calibration file in arm/calibration/<ARM_ID>.json (checked in).
ARM_ID=naive_follower

# Optional safety cap for playback: max degrees a joint may move per control step (empty = no cap).
MAX_RELATIVE_TARGET=10
