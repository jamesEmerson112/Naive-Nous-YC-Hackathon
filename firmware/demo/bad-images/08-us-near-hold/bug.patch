diff --git a/src/hcsr04.c b/src/hcsr04.c
index d86357c..51d1c0e 100644
--- a/src/hcsr04.c
+++ b/src/hcsr04.c
@@ -19,6 +19,12 @@ static uint8_t  active;          /* a measurement is in progress */
 static uint32_t start_ms;
 static uint8_t  report_busy;     /* hcsr04_start() found ECHO still high */
 
+/* Near-object hold. At 10 pings a second a hand moving through the beam can fall between two pings,
+ * and the arm's start gate would miss it. So a near reading is held: the nearest distance is reported
+ * until nothing has been near for HCSR04_HOLD_MS. */
+static uint32_t held_mm = UINT32_MAX;
+static uint32_t held_ms;
+
 static int echo_high(void)
 {
     return (ECHO_PORT->IDR >> ECHO_PIN) & 1u;
@@ -108,6 +114,15 @@ void hcsr04_start(uint32_t now_ms)
     trig_pulse();
 }
 
+static uint32_t near_hold(uint32_t mm, uint32_t now_ms)
+{
+    if (mm < held_mm || now_ms - held_ms >= HCSR04_HOLD_MS)
+        held_mm = mm;                   /* nearer, or the hold ran out: take the new reading */
+    if (held_mm < HCSR04_HOLD_NEAR_MM)
+        held_ms = now_ms;               /* something near: keep holding */
+    return held_mm;
+}
+
 int hcsr04_poll(uint32_t now_ms, hcsr04_result_t *out)
 {
     if (!active) return 0;
@@ -119,8 +134,9 @@ int hcsr04_poll(uint32_t now_ms, hcsr04_result_t *out)
     } else if (pulse_done) {
         uint32_t us = pulse_us;
         out->echo_us = us;
-        out->dist_mm = (us * 343u + 1000u) / 2000u;   /* us * 0.343 mm/us / 2, rounded */
-        out->status  = (us < HCSR04_MIN_ECHO_US || us > HCSR04_MAX_ECHO_US) ? HCSR04_OUT_OF_RANGE : HCSR04_OK;
+        out->dist_mm = near_hold((us * 343u + 1000u) / 2000u, now_ms);   /* us * 0.343 mm/us / 2, rounded */
+        /* the status describes the distance reported: a held hand in front of open space is "ok" */
+        out->status  = (out->dist_mm < HCSR04_MIN_MM || out->dist_mm > HCSR04_MAX_MM) ? HCSR04_OUT_OF_RANGE : HCSR04_OK;
     } else if (now_ms - start_ms >= HCSR04_TIMEOUT_MS) {
         /* Rose but never fell within 60 ms: past max range. Never rose: no echo at all. */
         out->status = rise_seen ? HCSR04_OUT_OF_RANGE : HCSR04_NO_ECHO;
