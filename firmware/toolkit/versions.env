# Pinned tool versions and SHA-256 checksums for the firmware toolkit.
# setup.sh refuses any download whose checksum doesn't match.
# To upgrade: change the version, set the new checksum (each xPack release
# publishes a .sha file next to every tarball), then run ./setup.sh.

# Arm GNU toolchain (gcc, binutils, newlib/newlib-nano, gdb), xPack build.
# https://github.com/xpack-dev-tools/arm-none-eabi-gcc-xpack/releases
GCC_VERSION=15.2.1-1.1
GCC_SHA256_linux_arm64=67980c7990eba7bb7ffdf39699102effd70889f5ac427be19a8c8a6c5fab2972
GCC_SHA256_linux_x64=da6a49ad4003944b823c6c93702a8787c922ab34bd7e918ec0eaf6933a9b1ff6
GCC_SHA256_darwin_arm64=574082d35e49a2bcbdc355836b2a3ae5e5bb3b9456c9f5e37177db2ab4aad870
GCC_SHA256_darwin_x64=5be906a5194c3173e145a58048e5607ffff947773237802b93e55e23c415f1b6
# Thumb multilibs setup.sh keeps (it deletes the rest unless run with --full):
#   v6-m: Cortex-M0/M0+ (STM32F0, L0, G0, C0, U0)
#   v7-m: Cortex-M3 (F1, F2, L1)
#   v7e-m(+fp/+dp): Cortex-M4/M7 (F3, F4, G4, L4, WB, F7, H7)
#   v8-m.*: Cortex-M23/M33 (L5, U5, H5, WBA)
GCC_KEEP_MULTILIBS="v6-m v7-m v7e-m v7e-m+fp v7e-m+dp v8-m.base v8-m.main v8-m.main+fp v8-m.main+dp"

# OpenOCD (flashing and debugging over SWD), xPack build.
# https://github.com/xpack-dev-tools/openocd-xpack/releases
OPENOCD_VERSION=0.12.0-7
OPENOCD_SHA256_linux_arm64=db73a3ab91c556ecec2405a7e02d404b11139df6aba1031cad94a7e6766d06cc
OPENOCD_SHA256_linux_x64=94b3790983beaf8ed57e646c0620dd66d705fddae03d290823a6ed3b439468d6
OPENOCD_SHA256_darwin_arm64=667342c086984f3e5a55b4e0d5f711add13fb04de040fca493303000e6c19327
OPENOCD_SHA256_darwin_x64=668ad25350103a4357e11629ec833eae5982e973889ce25bad0c2963e37fa8bf

# Arm CMSIS core headers (core_cm0.h and friends). Platform-independent.
# https://github.com/ARM-software/CMSIS_6
CMSIS_CORE_VERSION=6.3.0
CMSIS_CORE_SHA256=331df74000876b8fb07933658cbf402c4d9f831b429258792d2c34ab5a6c5bf7

# ST CMSIS device packs: register headers, startup code, system_*.c.
# List the STM32 families you need. To add one (for example g0), add it to
# the list and define CMSIS_DEVICE_<FAMILY>_VERSION and _SHA256 below.
# Repos are at https://github.com/STMicroelectronics/cmsis-device-<family>
CMSIS_DEVICE_FAMILIES="f0"
CMSIS_DEVICE_F0_VERSION=2.3.8
CMSIS_DEVICE_F0_SHA256=6518a9bd48dab051e00809be0227525d1b7dfbc4981e24037b888a2a08fae5e8
