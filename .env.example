# Romulus cloud platform settings (architecture §6). Copy to `.env` (git-ignored) and edit.
# Every adapter defaults to fake, so `make up` works offline with no keys.
# Going live means changing one variable per adapter. Tests never read this file.

# --- Compose (host side) ------------------------------------------------------------
# Project name and host port; change both to run a second copy side by side.
# COMPOSE_PROJECT_NAME=romulus
API_PORT=8000
# Number of fake arms for `make sim`.
FAKE_DEVICES_N=3

# --- Storage ---------------------------------------------------------------------------
# Inside Compose these are fixed to the db service and /data; set them only for host-side
# runs (e.g. `uv run python -m romulus_cloud.cli ...`).
# DATABASE_URL=postgresql+psycopg://romulus:romulus@db:5432/romulus
# BLOB_DIR=/data/blobs
# EXPORT_DIR=/data/exports
# Disk cap for episode blobs; incident evidence is never auto-deleted.
BLOB_BUDGET_GB=20
# Largest recording blob one PUT accepts, in bytes (telemetry §3; default 200 MB)
RECORDING_MAX_BYTES=209715200

# One tenant for v0, but every row carries it (D1).
FLEET_ID=default

# --- Naïve (work orders → board cards; naive-integration doc) -------------------------
# fake = log cards locally; live = call the Naïve API.
NAIVE_MODE=fake
# Secret. Scopes: agents:read, agents:write, sessions:read, audit:read.
NAIVE_API_KEY=
NAIVE_BASE_URL=https://api.vetta.sh/v1
NAIVE_VERSION=2026-09-30
# The CEO agent's agt_ id (the company board).
NAIVE_BOARD_ID=
NAIVE_OPS_AGENT=fleet-ops

# Spend caps, enforced in our code before a card is posted (D19b: over cap → blocked_over_cap).
ORDER_MAX_USD=50
ORDERS_PER_DAY_MAX=3
ORDERS_PER_ROBOT_DAY_MAX=1
# The day the per-day caps count in (IANA zone name).
FLEET_TIMEZONE=UTC

# What the work-order card says. The phone fleet-ops calls: a TEAMMATE's phone, never a
# business (K13). Live mode refuses to post cards while this is the placeholder.
WORK_ORDER_PHONE=TEAMMATE_PHONE
WORK_ORDER_DELIVER_TO=Romulus bench (set WORK_ORDER_DELIVER_TO)

# --- Batch-job LLM (D22) ----------------------------------------------------------------
# fake = templated text; live = call the provider.
LLM_MODE=fake
# fake | naive_proxy | runpod. One OpenAI-compatible client for both live providers.
LLM_PROVIDER=fake
# Naïve proxy: https://api.vetta.sh/v1/proxy/openai/v1 (key with proxy:write).
# RunPod: the team's vLLM endpoint (James's lane).
LLM_BASE_URL=
LLM_MODEL=
# Secret.
LLM_API_KEY=

# --- Coding agent for code patches (D21, D22; M8) ---------------------------------------
# fake | local_agent | naive_session
CODER_PROVIDER=fake
# local_agent: mini-swe-agent (the only agent built) in the coder image, which
# `make coder-image` builds as romulus-coder. It uses the LLM_BASE_URL/LLM_MODEL/LLM_API_KEY
# endpoint above, but only through a per-run proxy (B5): the agent's container sits on an
# internal Docker network whose one exit is a sidecar (cloud/coder/llm_proxy.py, same image)
# that forwards POST /chat/completions to LLM_BASE_URL and adds the key itself. The agent gets
# a per-job token, never LLM_API_KEY. There is no open-network mode.
CODER_AGENT=
CODER_IMAGE=
# Run in the sandbox after the agent finishes; its exit code decides `passed`. For the real
# device/ (B1) this is its own suite: device/pytest.ini points pytest at tests/ (18 tests,
# about a second, no network; `make device-check` proves it in the coder image).
CODER_TEST_CMD=python -m pytest -q
CODER_STEP_LIMIT=30
CODER_TIME_LIMIT_S=600
# Output tokens per LLM call: the agent asks for this and its proxy caps it (B5). The proxy
# also forces LLM_MODEL and drops every body field but messages/max_tokens/temperature/top_p/stop.
CODER_MAX_TOKENS=2000
# The gate's code replay (M8b): CODER_TEST_CMD plus the held-out verify scripts, in fresh
# containers with no network. Empty CODER_TEST_CMD = only the verify scripts run; with no
# verify scripts either, a coder candidate's replay fails (fail closed). The package's
# device/verify/ always runs; CODER_VERIFY_DIR adds a host dir of more verify scripts kept
# off the device (each file lands at verify/<its path>). device/ ships no verify/, so for the
# real code `make device-verify` writes SPEC.md property checks for the bench's planted
# faults to data/verify/device, with frozen copies of the supervisor and fake hardware it
# runs on, for the current device/ commit. Its MANIFEST.json names that commit: a replay on
# code that isn't it or a descendant fails as "stale verify" (regenerate). The relative path
# suits `make worker-host` (run from the repo root); a missing dir makes code candidates wait.
# In a Compose worker it would be /data/verify/device. The Fleet Doctor's sandbox check reads
# the same set (a stale or unreadable dir is left out there, with the reason).
CODER_VERIFY_DIR=data/verify/device
# WARNING: keep false. With no held-out verify scripts (no device/verify/, no
# CODER_VERIFY_DIR files, e.g. `make device-verify` was skipped), a coder or Fleet Doctor
# code candidate waits at the gate: the device tests run in the same process as the code
# under test, which can forge their result. true lets such a replay pass on those tests
# alone; each such run records an "unverified: decided by in-process tests only" event.
CODER_ALLOW_UNVERIFIED=false
CODER_REPLAY_TIMEOUT_S=300
# Scratch copies of the device code ("" = system temp; Docker must be able to mount it).
CODER_SCRATCH_DIR=
# Worker threads per slow-job pool (coder drafts and code replays have separate pools). With
# CODER_PROVIDER=local_agent the worker runs `docker run`, so run it on the host:
# `make worker-host` (never overnight).
JOBS_MAX_WORKERS=2
# Coding-agent drafts started per hour; identical patches share one. Over it: "coder budget".
CODER_MAX_DRAFTS_PER_HOUR=6

# Paths under device/ that count as the safety layer or visor (D5a, K17), as a JSON list.
# A code_patch touching any of them is flagged touches_safety. Placeholder until the device
# team's list arrives.
SAFETY_PATHS=["safety","visor"]

# --- Gate and batch timing ---------------------------------------------------------------
# Demo: 120 / 120. Overnight: 1200 / 3600.
CANARY_WINDOW_S=120
BATCH_INTERVAL_S=120
# A pass-through code candidate stops at awaiting_canary unless this is true (BUILD §3).
ALLOW_PASSTHROUGH_CODE_PROMOTION=false
# Time zone the pages show times in (M2, D10).
DISPLAY_TZ=America/Los_Angeles
# Worker loop period in seconds (architecture §5).
WORKER_TICK_S=2

# --- Overnight guard (build plan K7) --------------------------------------------------------
# Set to true when the overnight run starts; `make reset` then refuses unless FORCE=1.
OVERNIGHT_STARTED=false

# --- Fleet Doctor (docs/fleet-doctor/interfaces.md §7; D23-D26) ---------------------------
# off | fake | live. off: the ask route answers 503 and the worker's doctor.tick does nothing.
# fake: FakeLlm. live: the LLM_* provider above.
DOCTOR_MODE=off
# The cloud opens consults on unresolved non-hardware incidents by itself (D26).
DOCTOR_AUTO_CONSULT=false
# none | fake | coder. coder: the coding agent (CODER_PROVIDER) writes a reproduction test and
# the fix; each draft counts against CODER_MAX_DRAFTS_PER_HOUR, shared with the batch.
DOCTOR_DRAFT=fake
# stub | sandbox. sandbox: the repro test alone must fail on the base, then the full patch
# must pass CODER_TEST_CMD, in the coder image with no network (needs Docker).
DOCTOR_CHECK=stub
# Offer proposals whose check is only a stub (demos and F12); the event says so.
DOCTOR_OFFER_STUB_CHECKED=false
# Offer a sandbox-checked fix whose base has no held-out verify/ scripts (the check says
# "offered unverified"). While false such a consult closes advised: only verify decides.
DOCTOR_OFFER_UNVERIFIED=false
# Flip only after the device team's K17 list replaces SAFETY_PATHS. While false, every
# proposal is discarded with "safety paths unknown" (D25).
SAFETY_PATHS_CONFIRMED=false
DOCTOR_ASKS_PER_INCIDENT=6
# Asks with no incident, per device per day.
DOCTOR_ASKS_PER_DEVICE_DAY=30
DOCTOR_CONSULTS_PER_INCIDENT=2
# Daily spend across asks and consults (USD), checked before spending; FLEET_TIMEZONE day.
DOCTOR_DAILY_USD_CAP=5.0
# An estimate; set the real price per 1,000 tokens.
DOCTOR_USD_PER_1K_TOKENS=0.001
DOCTOR_ASK_TIMEOUT_S=15
DOCTOR_ASK_MAX_TOKENS=400
DOCTOR_DIAGNOSE_TIMEOUT_S=120
DOCTOR_DIAGNOSE_MAX_TOKENS=4000
DOCTOR_PROPOSAL_TTL_S=3600
# Consults only open for incidents received this recently (6 h): never backfill history.
DOCTOR_LOOKBACK_S=21600
DOCTOR_TICK_S=5
DOCTOR_MAX_OPEN=5
DOCTOR_JOB_WORKERS=2
# What one coder draft is assumed to cost (USD), checked against the daily cap before each
# draft and recorded when the coder doesn't report its tokens. An estimate.
DOCTOR_DRAFT_ESTIMATE_USD=0.10
# Case-file evidence: the agent-trace tail, and code excerpts of files the log or trace names.
DOCTOR_TRACE_TAIL_LINES=40
DOCTOR_TRACE_TAIL_BYTES=16000
DOCTOR_EVIDENCE_FILE_BYTES=4000
DOCTOR_EVIDENCE_CODE_BYTES=16000

# --- Naïve Technician (docs/naive-technician/design.md §10, D30) -----------------------------
# A `needs_human` work order with no catalogued part opens a case: one Naïve session writes a
# typed report, Romulus emails TECHNICIAN_EMAIL from the Technician's inbox and stages a
# price-checked cart that a person approves. off | fake (test fixture) | live. Replay is per case.
TECHNICIAN_MODE=live
# The Naïve agent, identity and inbox made in build-plan step 1.
NAIVE_TECHNICIAN_AGENT=
NAIVE_TECHNICIAN_IDENTITY=
NAIVE_TECHNICIAN_INBOX=
# The one recipient (a consenting teammate). Empty = no email is sent.
TECHNICIAN_EMAIL=
# Allowlisted parts as JSON: [{"origin","handle","variant_id","label"}]. Default: the two
# single WowRobo STS3215 variants (C018 12 V 48037575033049; C001 7.4 V 48037674090713, a
# different product handle). The case file lists only those matching ARM_SERVO_VARIANT.
# TECHNICIAN_VENDORS=[{"origin":"https://shop.wowrobo.com","handle":"feetech-sts3215-servo-12v-30kg-high-torque-servo-for-so-arm100","variant_id":"48037575033049","label":"WowRobo · Feetech STS3215 C018 12V"}]
# The servo variant on the arm (read the elbow servo's label).
ARM_SERVO_VARIANT=C018-12V
TECHNICIAN_SESSION_USD=3
TECHNICIAN_DAILY_USD_CAP=10
TECHNICIAN_TIMEOUT_S=600
# Only work orders newer than this (s) open a case on their own: no backfill storm.
TECHNICIAN_MAX_AGE_S=900
# A recorded session fixture that `?mode=replay` plays back over TECHNICIAN_REPLAY_SECONDS.
# Empty = the bundled demo recording (cloud/tests/fixtures/technician/joint_stall_live2.json).
TECHNICIAN_REPLAY_FILE=
TECHNICIAN_REPLAY_SECONDS=20

# --- Fleet learning (docs/recursive-self-improvement/design.md §3, §9) ---
# off | data (keep the standing `fleet-runs` dataset: snapshot + trajectories export, no model)
# | fixture | live (cluster review, later).
LEARNING_MODE=off
# Snapshot and export again once this many new pass/fail labelled runs arrived.
LEARNING_MIN_NEW=1
