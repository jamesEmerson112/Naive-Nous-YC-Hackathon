# Romulus cloud platform settings (architecture §6). Copy to `.env` (git-ignored) and edit.
# Every adapter defaults to fake, so `make up` works offline with no keys.
# Going live means changing one variable per adapter. Tests never read this file.

# --- Compose (host side) ------------------------------------------------------------
# Project name and host port; change both to run a second copy side by side.
# COMPOSE_PROJECT_NAME=romulus
API_PORT=8000
# Number of fake arms for `make sim`.
FAKE_DEVICES_N=4

# --- Storage ---------------------------------------------------------------------------
# Inside Compose these are fixed to the db service and /data; set them only for host-side
# runs (e.g. `uv run python -m romulus_cloud.cli ...`).
# DATABASE_URL=postgresql+psycopg://romulus:romulus@db:5432/romulus
# BLOB_DIR=/data/blobs
# EXPORT_DIR=/data/exports
# Disk cap for episode blobs; incident evidence is never auto-deleted.
BLOB_BUDGET_GB=20
# Largest recording blob one PUT accepts, in bytes (telemetry §3; default 200 MB)
RECORDING_MAX_BYTES=209715200

# One tenant for v0, but every row carries it (D1).
FLEET_ID=default

# --- Naïve (work orders → board cards; naive-integration doc) -------------------------
# fake = log cards locally; live = call the Naïve API.
NAIVE_MODE=fake
# Secret. Scopes: agents:read, agents:write, sessions:read, audit:read.
NAIVE_API_KEY=
NAIVE_BASE_URL=https://api.vetta.sh/v1
NAIVE_VERSION=2026-09-30
# The CEO agent's agt_ id (the company board).
NAIVE_BOARD_ID=
NAIVE_OPS_AGENT=fleet-ops

# Spend caps, enforced in our code before a card is posted (D19b: over cap → blocked_over_cap).
ORDER_MAX_USD=50
ORDERS_PER_DAY_MAX=3
ORDERS_PER_ROBOT_DAY_MAX=1

# --- Batch-job LLM (D22) ----------------------------------------------------------------
# fake = templated text; live = call the provider.
LLM_MODE=fake
# fake | naive_proxy | runpod. One OpenAI-compatible client for both live providers.
LLM_PROVIDER=fake
# Naïve proxy: https://api.vetta.sh/v1/proxy/openai/v1 (key with proxy:write).
# RunPod: the team's vLLM endpoint (James's lane).
LLM_BASE_URL=
LLM_MODEL=
# Secret.
LLM_API_KEY=

# --- Coding agent for code patches (D21, D22; M8) ---------------------------------------
# fake | local_agent | naive_session
CODER_PROVIDER=fake
CODER_AGENT=
CODER_IMAGE=

# Paths under device/ that count as the safety layer or visor (D5a, K17), as a JSON list.
# A code_patch touching any of them is flagged touches_safety. Placeholder until the device
# team's list arrives.
SAFETY_PATHS=["safety","visor"]

# --- Gate and batch timing ---------------------------------------------------------------
# Demo: 120 / 120. Overnight: 1200 / 3600.
CANARY_WINDOW_S=120
BATCH_INTERVAL_S=120
# A pass-through code candidate stops at awaiting_canary unless this is true (BUILD §3).
ALLOW_PASSTHROUGH_CODE_PROMOTION=false
# Time zone the pages show times in (M2, D10).
DISPLAY_TZ=America/Los_Angeles
# Worker loop period in seconds (architecture §5).
WORKER_TICK_S=2

# --- Overnight guard (build plan K7) --------------------------------------------------------
# Set to true when the overnight run starts; `make reset` then refuses unless FORCE=1.
OVERNIGHT_STARTED=false
