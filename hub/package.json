{
  "name": "stack-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One-page map of the arm company's infrastructure, team lanes and tools, published as a claude.ai artifact.",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/to-artifact.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
