{
 "$id": "arm-fixplan/v1",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "incident_id",
  "action",
  "args",
  "kind",
  "confidence",
  "touches_safety",
  "why"
 ],
 "properties": {
  "schema": {
   "const": "arm-fixplan/v1"
  },
  "incident_id": {
   "type": "string"
  },
  "action": {
   "enum": [
    "restart_sensor",
    "verify",
    "pod_rollback",
    "redo_step",
    "park",
    "handoff_human",
    "no_action"
   ]
  },
  "args": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "from_step": {
     "enum": [
      "reach",
      "approach",
      "grip",
      "lift",
      "release"
     ]
    },
    "correction": {
     "enum": [
      "none",
      "relocate",
      "offset"
     ]
    },
    "dx_mm": {
     "type": "integer",
     "minimum": -40,
     "maximum": 40
    },
    "dy_mm": {
     "type": "integer",
     "minimum": -40,
     "maximum": 40
    }
   }
  },
  "kind": {
   "type": "string",
   "maxLength": 40
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "touches_safety": {
   "type": "boolean"
  },
  "why": {
   "type": "string",
   "maxLength": 400
  },
  "expect": {
   "type": "string",
   "maxLength": 200
  }
 }
}
