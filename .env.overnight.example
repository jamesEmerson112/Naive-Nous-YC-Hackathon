# Overnight run settings (flows F10, build plan M7). Runbook: cloud/OVERNIGHT.md §2.
#
#   cp .env.overnight.example .env.overnight
#
# Compose loads .env, then .env.overnight, into api, worker and fake-devices
# (compose.yaml `env_file`), so these values win; .env (your real keys) is never touched.
# Delete .env.overnight (and `make up`) to leave overnight mode. Keep secrets in .env,
# not here. `make overnight-check` shows which files are active and what the running
# containers actually resolve.

# =========================================================================================
# !!! NAIVE_MODE MUST STAY fake OVERNIGHT !!!
# The chaos schedule plants hardware faults all night, and every one becomes a work order.
# In live mode each would post a Naïve card and the fleet-ops agent could PHONE A REAL
# SUPPLIER AT 3 AM (build plan K13, naive-integration §6). Never let a test loop call a
# real business. `make overnight-check` FAILS if the api container doesn't see `fake`.
# =========================================================================================
NAIVE_MODE=fake

# Gate and batch at overnight pace (architecture §6): a 20 min canary window and one batch
# run an hour, instead of the 120 s demo values.
CANARY_WINDOW_S=1200
BATCH_INTERVAL_S=3600

# The batch-job LLM stays fake by default, so the night needs no keys and no network.
# To use the Naïve model proxy instead (D22; needs a key with proxy:write):
#   LLM_MODE=live
#   LLM_PROVIDER=naive_proxy
#   LLM_BASE_URL=https://api.vetta.sh/v1/proxy/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_API_KEY=...   (put the secret in .env, not here)
LLM_MODE=fake
LLM_PROVIDER=fake

# The coding agent (M8) stays fake overnight too.
CODER_PROVIDER=fake

# Disk cap for episode blobs; the worker deletes the oldest unlabeled episodes above it.
# Incident evidence is never deleted.
BLOB_BUDGET_GB=20

# `make reset` refuses while this is true, unless FORCE=1 (build plan K7). Also run
# `make overnight-start`, which records the start in the database (same guard, and the
# digest counts from that moment).
OVERNIGHT_STARTED=true
